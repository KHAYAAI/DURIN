// DURIN — M1 Developer Platform schema
// Ledger models land in M2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganisationStatus {
  active
  suspended
  pending_verification
}

enum MembershipRole {
  owner
  admin
  developer
  viewer
}

model Organisation {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  status    OrganisationStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  members            OrganisationMember[]
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  idempotencyRecords IdempotencyRecord[]

  @@map("organisations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships OrganisationMember[]

  @@map("users")
}

model OrganisationMember {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole @default(developer)
  createdAt      DateTime       @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@map("organisation_members")
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  name           String
  keyPrefix      String    @map("key_prefix")
  keyHash        String    @map("key_hash")
  scopes         String[]  @default([])
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([keyPrefix])
  @@index([organisationId])
  @@map("api_keys")
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, idempotencyKey])
  @@map("idempotency_records")
}

model WebhookEndpoint {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  url            String
  secretHash     String   @map("secret_hash")
  events         String[] @default([])
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("webhook_endpoints")
}

// ─── M2 Ledger ───────────────────────────────────────────────

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
  system
}

enum JournalStatus {
  posted
}

model LedgerAccount {
  id             String      @id @default(uuid()) @db.Uuid
  organisationId String      @map("organisation_id") @db.Uuid
  code           String
  name           String
  accountType    AccountType @map("account_type")
  assetCode      String      @map("asset_code")
  allowNegative  Boolean     @default(false) @map("allow_negative")
  status         String      @default("active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  lines    JournalLine[]
  balances Balance[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("ledger_accounts")
}

model Journal {
  id             String        @id @default(uuid()) @db.Uuid
  organisationId String        @map("organisation_id") @db.Uuid
  reference      String?
  description    String?
  status         JournalStatus @default(posted)
  idempotencyKey String?       @map("idempotency_key")
  postedAt       DateTime      @default(now()) @map("posted_at")
  valueDate      DateTime?     @map("value_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at")

  lines JournalLine[]

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId])
  @@map("journals")
}

model JournalLine {
  id        String   @id @default(uuid()) @db.Uuid
  journalId String   @map("journal_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  direction String   // debit | credit
  amount    Decimal  @db.Decimal(36, 18)
  assetCode String   @map("asset_code")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  journal Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@map("journal_lines")
}

model Balance {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  assetCode      String   @map("asset_code")
  available      Decimal  @default(0) @db.Decimal(36, 18)
  pending        Decimal  @default(0) @db.Decimal(36, 18)
  reserved       Decimal  @default(0) @db.Decimal(36, 18)
  updatedAt      DateTime @updatedAt @map("updated_at")

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId])
  @@index([organisationId])
  @@map("balances")
}

// ─── M3 Payments ─────────────────────────────────────────────

enum PaymentIntentStatus {
  created
  pending
  requires_action
  processing
  confirmed
  settled
  failed
  cancelled
  expired
}

model PaymentIntent {
  id                   String              @id @default(uuid()) @db.Uuid
  organisationId       String              @map("organisation_id") @db.Uuid
  amount               Decimal             @db.Decimal(36, 18)
  assetCode            String              @map("asset_code")
  status               PaymentIntentStatus @default(created)
  description          String?
  customerReference    String?             @map("customer_reference")
  metadata             Json?
  /// Simulated deposit address / instruction for sandbox stablecoin payment
  paymentInstructions  Json?               @map("payment_instructions")
  journalId            String?             @map("journal_id") @db.Uuid
  idempotencyKey       String?             @map("idempotency_key")
  expiresAt            DateTime?           @map("expires_at")
  confirmedAt          DateTime?           @map("confirmed_at")
  settledAt            DateTime?           @map("settled_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  links PaymentLink[]

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId])
  @@index([status])
  @@map("payment_intents")
}

model PaymentLink {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  paymentIntentId String?   @map("payment_intent_id") @db.Uuid
  urlSlug         String    @unique @map("url_slug")
  amount          Decimal?  @db.Decimal(36, 18)
  assetCode       String?   @map("asset_code")
  description     String?
  active          Boolean   @default(true)
  metadata        Json?
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id])

  @@index([organisationId])
  @@map("payment_links")
}

// ─── M4 Conversion ───────────────────────────────────────────

enum QuoteStatus {
  open
  accepted
  expired
  cancelled
}

enum ConversionStatus {
  quoted
  accepted
  processing
  settlement_pending
  settled
  failed
  expired
}

model Quote {
  id              String      @id @default(uuid()) @db.Uuid
  organisationId  String      @map("organisation_id") @db.Uuid
  sourceAsset     String      @map("source_asset")
  targetAsset     String      @map("target_asset")
  sourceAmount    Decimal     @map("source_amount") @db.Decimal(36, 18)
  targetAmount    Decimal     @map("target_amount") @db.Decimal(36, 18)
  rate            Decimal     @db.Decimal(36, 18)
  feeAmount       Decimal     @default(0) @map("fee_amount") @db.Decimal(36, 18)
  feeAsset        String      @map("fee_asset")
  status          QuoteStatus @default(open)
  expiresAt       DateTime    @map("expires_at")
  metadata        Json?
  createdAt       DateTime    @default(now()) @map("created_at")

  conversions Conversion[]

  @@index([organisationId])
  @@map("quotes")
}

model Conversion {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  quoteId        String           @map("quote_id") @db.Uuid
  sourceAsset    String           @map("source_asset")
  targetAsset    String           @map("target_asset")
  sourceAmount   Decimal          @map("source_amount") @db.Decimal(36, 18)
  targetAmount   Decimal          @map("target_amount") @db.Decimal(36, 18)
  rate           Decimal          @db.Decimal(36, 18)
  feeAmount      Decimal          @map("fee_amount") @db.Decimal(36, 18)
  status         ConversionStatus @default(accepted)
  journalId      String?          @map("journal_id") @db.Uuid
  idempotencyKey String?          @map("idempotency_key")
  failureReason  String?          @map("failure_reason")
  settledAt      DateTime?        @map("settled_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  quote Quote @relation(fields: [quoteId], references: [id])

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId])
  @@index([status])
  @@map("conversions")
}

// ─── M5 Wallets / Layer 1 orchestration ──────────────────────

enum WithdrawalStatus {
  requested
  pending_approval
  approved
  processing
  submitted
  confirmed
  failed
  cancelled
}

model Wallet {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  label          String?
  provider       String   @default("sandbox")
  externalRef    String?  @map("external_ref")
  status         String   @default("active")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  addresses   DepositAddress[]
  withdrawals WithdrawalRequest[]

  @@index([organisationId])
  @@map("wallets")
}

model DepositAddress {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  walletId       String   @map("wallet_id") @db.Uuid
  assetCode      String   @map("asset_code")
  chain          String   @default("ethereum-sepolia")
  address        String
  providerRef    String?  @map("provider_ref")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([address])
  @@map("deposit_addresses")
}

model WithdrawalRequest {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  walletId       String           @map("wallet_id") @db.Uuid
  assetCode      String           @map("asset_code")
  amount         Decimal          @db.Decimal(36, 18)
  destination    String
  chain          String           @default("ethereum-sepolia")
  status         WithdrawalStatus @default(requested)
  providerRef    String?          @map("provider_ref")
  txHash         String?          @map("tx_hash")
  journalId      String?          @map("journal_id") @db.Uuid
  failureReason  String?          @map("failure_reason")
  idempotencyKey String?          @map("idempotency_key")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId])
  @@map("withdrawal_requests")
}

// ─── M6 Compliance ───────────────────────────────────────────

enum VerificationStatus {
  not_started
  pending
  approved
  rejected
  expired
}

enum ApprovalStatus {
  pending
  approved
  rejected
  cancelled
}

model VerificationRecord {
  id             String             @id @default(uuid()) @db.Uuid
  organisationId String             @map("organisation_id") @db.Uuid
  subjectType    String             @map("subject_type") // organisation | user | wallet
  subjectId      String             @map("subject_id")
  provider       String             @default("sandbox")
  status         VerificationStatus @default(not_started)
  level          String             @default("kyb_basic")
  metadata       Json?
  reviewedAt     DateTime?          @map("reviewed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([organisationId])
  @@index([subjectType, subjectId])
  @@map("verification_records")
}

model ScreeningResult {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  subjectType    String   @map("subject_type")
  subjectId      String   @map("subject_id")
  screeningType  String   @map("screening_type") // sanctions | wallet | adverse_media
  provider       String   @default("sandbox")
  result         String   // clear | hit | error
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organisationId])
  @@map("screening_results")
}

model LimitPolicy {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  assetCode      String?  @map("asset_code")
  dailyLimit     Decimal? @map("daily_limit") @db.Decimal(36, 18)
  perTxLimit     Decimal? @map("per_tx_limit") @db.Decimal(36, 18)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organisationId])
  @@map("limit_policies")
}

model ApprovalRequest {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  resourceType   String         @map("resource_type") // withdrawal | conversion | payout
  resourceId     String         @map("resource_id")
  amount         Decimal?       @db.Decimal(36, 18)
  assetCode      String?        @map("asset_code")
  status         ApprovalStatus @default(pending)
  requestedBy    String?        @map("requested_by")
  decidedBy      String?        @map("decided_by")
  decisionNote   String?        @map("decision_note")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([organisationId])
  @@index([status])
  @@map("approval_requests")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  actorType      String   @map("actor_type") // api_key | user | system
  actorId        String?  @map("actor_id")
  action         String
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id")
  ip             String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organisationId])
  @@index([createdAt])
  @@map("audit_logs")
}
