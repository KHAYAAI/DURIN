// DURIN — M1 Developer Platform schema
// Ledger models land in M2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganisationStatus {
  active
  suspended
  pending_verification
}

enum MembershipRole {
  owner
  admin
  developer
  viewer
}

model Organisation {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  status               OrganisationStatus @default(active)
  /// The WorkOS organization whose members may sign in to this organisation (SSO / AuthKit).
  workosOrganizationId String?            @unique @map("workos_organization_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  members            OrganisationMember[]
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  idempotencyRecords IdempotencyRecord[]

  @@map("organisations")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships OrganisationMember[]

  @@map("users")
}

model OrganisationMember {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole @default(developer)
  createdAt      DateTime       @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@map("organisation_members")
}

model ApiKey {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  name           String
  keyPrefix      String    @map("key_prefix")
  keyHash        String    @map("key_hash")
  scopes         String[]  @default([])
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([keyPrefix])
  @@index([organisationId])
  @@map("api_keys")
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, idempotencyKey])
  @@map("idempotency_records")
}

model WebhookEndpoint {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  url            String
  /// AES-256-GCM encrypted signing secret (see common/crypto-secrets.ts). Never stored in plaintext.
  secretEnc      String   @map("secret_enc")
  events         String[] @default([])
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organisationId])
  @@map("webhook_endpoints")
}

/// Durable outbox of webhook events. Written in the request path, delivered by a worker with
/// retries, so a slow or failing customer endpoint never blocks the API.
model WebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @map("organisation_id") @db.Uuid
  endpointId     String    @map("endpoint_id") @db.Uuid
  eventId        String    @map("event_id")
  eventType      String    @map("event_type")
  payload        Json
  status         String    @default("pending") // pending | succeeded | failed
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at")
  lastStatus     Int?      @map("last_status")
  lastError      String?   @map("last_error")
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([organisationId])
  @@map("webhook_deliveries")
}

// ─── M2 Ledger ───────────────────────────────────────────────

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
  system
}

enum JournalStatus {
  posted
}

model LedgerAccount {
  id             String      @id @default(uuid()) @db.Uuid
  organisationId String      @map("organisation_id") @db.Uuid
  code           String
  name           String
  accountType    AccountType @map("account_type")
  assetCode      String      @map("asset_code")
  allowNegative  Boolean     @default(false) @map("allow_negative")
  /// customer | reserved | in_transit | custody_ref | lp_clearing | fee_revenue (see ledger/chart.ts)
  role           String?
  /// For custody_ref accounts: which layer holds the real funds (layer1 = crypto custody, layer2 = regulated fiat)
  custodian      String?
  status         String      @default("active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  lines    JournalLine[]
  balances Balance[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("ledger_accounts")
}

model Journal {
  id             String        @id @default(uuid()) @db.Uuid
  organisationId String        @map("organisation_id") @db.Uuid
  reference      String?
  description    String?
  status         JournalStatus @default(posted)
  idempotencyKey String?       @map("idempotency_key")
  postedAt       DateTime      @default(now()) @map("posted_at")
  valueDate      DateTime?     @map("value_date") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at")

  lines JournalLine[]

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId])
  @@map("journals")
}

model JournalLine {
  id        String   @id @default(uuid()) @db.Uuid
  journalId String   @map("journal_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  direction String // debit | credit
  amount    Decimal  @db.Decimal(36, 18)
  assetCode String   @map("asset_code")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  journal Journal       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@map("journal_lines")
}

model Balance {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  assetCode      String   @map("asset_code")
  available      Decimal  @default(0) @db.Decimal(36, 18)
  pending        Decimal  @default(0) @db.Decimal(36, 18)
  reserved       Decimal  @default(0) @db.Decimal(36, 18)
  updatedAt      DateTime @updatedAt @map("updated_at")

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId])
  @@index([organisationId])
  @@map("balances")
}

// ─── M3 Payments ─────────────────────────────────────────────

enum PaymentIntentStatus {
  created
  pending
  requires_action
  processing
  confirmed
  settled
  failed
  cancelled
  expired
}

model PaymentIntent {
  id                  String              @id @default(uuid()) @db.Uuid
  organisationId      String              @map("organisation_id") @db.Uuid
  amount              Decimal             @db.Decimal(36, 18)
  assetCode           String              @map("asset_code")
  status              PaymentIntentStatus @default(created)
  description         String?
  customerReference   String?             @map("customer_reference")
  metadata            Json?
  /// Simulated deposit address / instruction for sandbox stablecoin payment
  paymentInstructions Json?               @map("payment_instructions")
  journalId           String?             @map("journal_id") @db.Uuid
  idempotencyKey      String?             @map("idempotency_key")
  expiresAt           DateTime?           @map("expires_at")
  confirmedAt         DateTime?           @map("confirmed_at")
  settledAt           DateTime?           @map("settled_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  links PaymentLink[]

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId])
  @@index([status])
  @@map("payment_intents")
}

model PaymentLink {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  paymentIntentId String?   @map("payment_intent_id") @db.Uuid
  urlSlug         String    @unique @map("url_slug")
  amount          Decimal?  @db.Decimal(36, 18)
  assetCode       String?   @map("asset_code")
  description     String?
  active          Boolean   @default(true)
  metadata        Json?
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id])

  @@index([organisationId])
  @@map("payment_links")
}

// ─── M4 Conversion ───────────────────────────────────────────

enum QuoteStatus {
  open
  accepted
  expired
  cancelled
}

enum ConversionStatus {
  quoted
  accepted
  processing
  settlement_pending
  settled
  failed
  expired
}

model Quote {
  id             String      @id @default(uuid()) @db.Uuid
  organisationId String      @map("organisation_id") @db.Uuid
  sourceAsset    String      @map("source_asset")
  targetAsset    String      @map("target_asset")
  sourceAmount   Decimal     @map("source_amount") @db.Decimal(36, 18)
  targetAmount   Decimal     @map("target_amount") @db.Decimal(36, 18)
  rate           Decimal     @db.Decimal(36, 18)
  feeAmount      Decimal     @default(0) @map("fee_amount") @db.Decimal(36, 18)
  feeAsset       String      @map("fee_asset")
  status         QuoteStatus @default(open)
  expiresAt      DateTime    @map("expires_at")
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  conversions Conversion[]

  @@index([organisationId])
  @@map("quotes")
}

model Conversion {
  id               String           @id @default(uuid()) @db.Uuid
  organisationId   String           @map("organisation_id") @db.Uuid
  quoteId          String           @map("quote_id") @db.Uuid
  sourceAsset      String           @map("source_asset")
  targetAsset      String           @map("target_asset")
  sourceAmount     Decimal          @map("source_amount") @db.Decimal(36, 18)
  targetAmount     Decimal          @map("target_amount") @db.Decimal(36, 18)
  rate             Decimal          @db.Decimal(36, 18)
  feeAmount        Decimal          @map("fee_amount") @db.Decimal(36, 18)
  status           ConversionStatus @default(accepted)
  /// The fill journal (kept for API compatibility).
  journalId        String?          @map("journal_id") @db.Uuid
  reserveJournalId String?          @map("reserve_journal_id") @db.Uuid
  fillJournalId    String?          @map("fill_journal_id") @db.Uuid
  settleJournalId  String?          @map("settle_journal_id") @db.Uuid
  providerRef      String?          @map("provider_ref")
  /// True when a liquidity-provider call may or may not have executed. Funds stay reserved;
  /// the call is never repeated and is only resolved by querying the provider.
  providerUnknown  Boolean          @default(false) @map("provider_unknown")
  idempotencyKey   String?          @map("idempotency_key")
  failureReason    String?          @map("failure_reason")
  settledAt        DateTime?        @map("settled_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  quote Quote @relation(fields: [quoteId], references: [id])

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId])
  @@index([status])
  @@map("conversions")
}

// ─── M5 Wallets / Layer 1 orchestration ──────────────────────

enum WithdrawalStatus {
  requested
  pending_approval
  approved
  processing
  submitted
  confirmed
  failed
  cancelled
}

model Wallet {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  label          String?
  provider       String   @default("sandbox")
  externalRef    String?  @map("external_ref")
  status         String   @default("active")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  addresses   DepositAddress[]
  withdrawals WithdrawalRequest[]

  @@index([organisationId])
  @@map("wallets")
}

model DepositAddress {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  walletId       String   @map("wallet_id") @db.Uuid
  assetCode      String   @map("asset_code")
  chain          String   @default("ethereum-sepolia")
  address        String
  providerRef    String?  @map("provider_ref")
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([address])
  @@map("deposit_addresses")
}

model WithdrawalRequest {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  walletId       String           @map("wallet_id") @db.Uuid
  assetCode      String           @map("asset_code")
  amount         Decimal          @db.Decimal(36, 18)
  destination    String
  chain          String           @default("ethereum-sepolia")
  status         WithdrawalStatus @default(requested)
  providerRef    String?          @map("provider_ref")
  txHash         String?          @map("tx_hash")
  journalId      String?          @map("journal_id") @db.Uuid
  failureReason  String?          @map("failure_reason")
  idempotencyKey String?          @map("idempotency_key")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId])
  @@map("withdrawal_requests")
}

// ─── M6 Compliance ───────────────────────────────────────────

enum VerificationStatus {
  not_started
  pending
  approved
  rejected
  expired
}

enum ApprovalStatus {
  pending
  approved
  rejected
  cancelled
}

model VerificationRecord {
  id              String             @id @default(uuid()) @db.Uuid
  organisationId  String             @map("organisation_id") @db.Uuid
  subjectType     String             @map("subject_type") // organisation | user | wallet
  subjectId       String             @map("subject_id")
  provider        String             @default("sandbox")
  status          VerificationStatus @default(not_started)
  level           String             @default("kyb_basic")
  metadata        Json?
  /// Provider's session id (e.g. Didit session_id). The record id is sent to the provider as vendor_data.
  externalId      String?            @map("external_id")
  /// The provider's own status text (e.g. "In Review"); `status` is DURIN's normalised status.
  providerStatus  String?            @map("provider_status")
  verificationUrl String?            @map("verification_url")
  lastEventId     String?            @map("last_event_id")
  expiresAt       DateTime?          @map("expires_at")
  reviewedAt      DateTime?          @map("reviewed_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@unique([provider, externalId])
  @@index([organisationId])
  @@index([subjectType, subjectId])
  @@map("verification_records")
}

model ScreeningResult {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  subjectType    String   @map("subject_type")
  subjectId      String   @map("subject_id")
  screeningType  String   @map("screening_type") // sanctions | wallet | adverse_media
  provider       String   @default("sandbox")
  result         String // clear | hit | error
  details        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organisationId])
  @@map("screening_results")
}

model LimitPolicy {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  name           String
  assetCode      String?  @map("asset_code")
  dailyLimit     Decimal? @map("daily_limit") @db.Decimal(36, 18)
  perTxLimit     Decimal? @map("per_tx_limit") @db.Decimal(36, 18)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organisationId])
  @@map("limit_policies")
}

model ApprovalRequest {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @map("organisation_id") @db.Uuid
  resourceType   String         @map("resource_type") // withdrawal | conversion | payout
  resourceId     String         @map("resource_id")
  amount         Decimal?       @db.Decimal(36, 18)
  assetCode      String?        @map("asset_code")
  status         ApprovalStatus @default(pending)
  requestedBy    String?        @map("requested_by")
  decidedBy      String?        @map("decided_by")
  decisionNote   String?        @map("decision_note")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([organisationId])
  @@index([status])
  @@map("approval_requests")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @map("organisation_id") @db.Uuid
  actorType      String   @map("actor_type") // api_key | user | system
  actorId        String?  @map("actor_id")
  action         String
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id")
  ip             String?
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organisationId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Production: provider call log, reconciliation, webhooks, MFA ────────────

/// Written BEFORE any external provider call (intent-before-send) and completed after, so a crash
/// or timeout leaves an observable `sent`/`unknown` row instead of a silent gap.
model ProviderCall {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  provider        String
  operation       String
  entityType      String    @map("entity_type")
  entityId        String    @map("entity_id")
  /// Idempotency reference sent to the provider (we use the entity id).
  clientReference String    @map("client_reference")
  status          String    @default("sent") // sent | succeeded | failed | unknown
  detail          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  @@unique([provider, operation, clientReference])
  @@index([organisationId])
  @@index([status, createdAt])
  @@map("provider_calls")
}

model ReconciliationRun {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  status         String // clean | breaks
  /// simulated (sandbox adapters) | live
  source         String
  summary        Json
  checkedAt      DateTime @default(now()) @map("checked_at")

  breaks ReconciliationBreak[]

  @@index([organisationId, checkedAt])
  @@map("reconciliation_runs")
}

model ReconciliationBreak {
  id             String   @id @default(uuid()) @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  assetCode      String   @map("asset_code")
  custodian      String
  /// custody_mismatch | insolvent | provider_error
  kind           String
  ledgerAmount   Decimal  @map("ledger_amount") @db.Decimal(36, 18)
  reportedAmount Decimal? @map("reported_amount") @db.Decimal(36, 18)
  delta          Decimal? @db.Decimal(36, 18)
  status         String   @default("open") // open | acknowledged
  note           String?
  acknowledgedBy String?  @map("acknowledged_by")
  createdAt      DateTime @default(now()) @map("created_at")

  run ReconciliationRun @relation(fields: [runId], references: [id])

  @@index([organisationId, status])
  @@map("reconciliation_breaks")
}

/// De-duplicates provider webhooks (e.g. Didit `event_id`): at-least-once delivery, exactly-once effect.
model ProcessedWebhookEvent {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  eventId    String   @map("event_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@map("processed_webhook_events")
}

/// A TOTP challenge started by a signed-in user, bound to their WorkOS session.
model MfaChallenge {
  id                String   @id @default(uuid()) @db.Uuid
  organisationId    String   @map("organisation_id") @db.Uuid
  userId            String   @map("user_id")
  sessionId         String   @map("session_id")
  factorId          String   @map("factor_id")
  workosChallengeId String   @map("workos_challenge_id")
  attempts          Int      @default(0)
  status            String   @default("pending") // pending | verified | failed | expired
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId, sessionId])
  @@map("mfa_challenges")
}

/// Short-lived, session-bound proof that a user completed a TOTP challenge. WorkOS access tokens
/// carry no MFA claim, so DURIN records this itself and checks it before sensitive actions.
model MfaVerification {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  userId         String   @map("user_id")
  sessionId      String   @map("session_id")
  factorId       String   @map("factor_id")
  verifiedAt     DateTime @default(now()) @map("verified_at")
  expiresAt      DateTime @map("expires_at")

  @@index([userId, sessionId, expiresAt])
  @@map("mfa_verifications")
}

/// Gate G1: a human-recorded counsel sign-off that live conversion may operate for an organisation.
/// DURIN never infers this; it is created through an MFA-protected admin action and is revocable.
model GateApproval {
  id               String    @id @default(uuid()) @db.Uuid
  organisationId   String    @map("organisation_id") @db.Uuid
  gate             String // 'G1'
  counselReference String    @map("counsel_reference")
  documentSha256   String    @map("document_sha256")
  /// { assets: string[], jurisdictions: string[] } the sign-off covers
  scope            Json
  approvedBy       String    @map("approved_by")
  approvedAt       DateTime  @default(now()) @map("approved_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedBy        String?   @map("revoked_by")

  @@index([organisationId, gate])
  @@map("gate_approvals")
}
