# Copy to .env and fill in. NEVER commit real values.
# Generate secrets with:   openssl rand -base64 32

# ── Local Postgres (infrastructure/docker-compose.yml) ───────────────────────
POSTGRES_USER=durin_owner
POSTGRES_PASSWORD=
DURIN_APP_PASSWORD=

# ── API (api/) ───────────────────────────────────────────────────────────────
# Runtime connection: the least-privilege login (member of durin_runtime).
DATABASE_URL=postgresql://durin_app:<DURIN_APP_PASSWORD>@localhost:5432/durin
# Migrations: the schema owner. Used only by `pnpm db:migrate`.
MIGRATION_DATABASE_URL=postgresql://durin_owner:<POSTGRES_PASSWORD>@localhost:5432/durin
DURIN_RUNTIME_ROLE=durin_app

PORT=3000
NODE_ENV=development
# 32 random bytes, base64. REQUIRED in production (encrypts webhook signing secrets).
DURIN_ENCRYPTION_KEY=
# Gates POST /v1/organisations. REQUIRED in production (>= 24 chars); open in development if unset.
BOOTSTRAP_TOKEN=
RATE_LIMIT_PER_MINUTE=120
# Behind a reverse proxy set the number of trusted hops (e.g. 1) so client IPs are correct.
TRUST_PROXY=
# Comma-separated browser origins allowed to call the API (none by default: server-to-server API).
CORS_ORIGINS=
# Providers. Production refuses to start with `sandbox`.
LAYER1_ADAPTER=sandbox
LAYER2_ADAPTER=sandbox

# ── Identity: Didit (KYC/KYB) ────────────────────────────────────────────────
# VERIFICATION_PROVIDER=sandbox (default) simulates; `didit` calls Didit. Required in production.
VERIFICATION_PROVIDER=sandbox
DIDIT_API_KEY=
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_WORKFLOW_KYB=
DIDIT_WORKFLOW_KYC=
# Shared secret of the Didit webhook destination (POST <api>/v1/webhooks/didit, version v3).
DIDIT_WEBHOOK_SECRET=
# Optional: previous secret during rotation overlap.
DIDIT_WEBHOOK_SECRET_PREVIOUS=
DIDIT_CALLBACK_URL=

# ── Auth: WorkOS (SSO + MFA) — used by BOTH api/ and dashboard/ ──────────────
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Dashboard only: 32+ char random string that encrypts the session cookie.
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3001/callback
# API: how long a TOTP step-up stays valid for a session (default 15).
MFA_STEPUP_TTL_MINUTES=15

# ── Chains / monitoring / safety ─────────────────────────────────────────────
# Enabled (asset:chain) pairs on mainnet. Default: USDC:ethereum,USDC:solana. USDT is off until compliance approves.
ENABLED_CHAINS=
# Bearer token for GET /metrics (required in production, otherwise the endpoint is disabled).
METRICS_TOKEN=
# Reject custodian balance snapshots older than this when reconciling (default 300).
RECONCILIATION_MAX_STALENESS_SECONDS=300
# Minutes after an order was sent before an operator may confirm "not executed" (default 15).
RESOLVE_NOT_EXECUTED_MIN_AGE_MINUTES=15

# ── Conversion / reconciliation ──────────────────────────────────────────────
LIQUIDITY_ADAPTER=sandbox
# Gate G1. Leave unset until counsel sign-off is recorded; production refuses conversions without it.
CONVERSION_LIVE_ENABLED=
# Seconds between automatic reconciliation runs (0/unset = off).
RECONCILIATION_INTERVAL_SECONDS=

# ── Dashboard (dashboard/) — SERVER-SIDE ONLY, never NEXT_PUBLIC_* ───────────
DURIN_API_URL=http://localhost:3000/v1
# Use a READ-ONLY key (organisations:read payments:read conversions:read compliance:read ledger:read).
DURIN_API_KEY=
# Local development only: with WorkOS unset the dashboard uses DURIN_API_KEY. In production it
# fails closed (503) unless WorkOS is configured, and calls the API as the signed-in user.

# ── Integration tests (api: pnpm test:integration) ───────────────────────────
DURIN_TEST_ADMIN_URL=postgresql://postgres:<password>@localhost:5432/durin_test
DURIN_TEST_APP_URL=postgresql://durin_app:<password>@localhost:5432/durin_test
