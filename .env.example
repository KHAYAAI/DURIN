# Copy to .env and fill in. NEVER commit real values.
# Generate secrets with:   openssl rand -base64 32

# ── Local Postgres (infrastructure/docker-compose.yml) ───────────────────────
POSTGRES_USER=durin_owner
POSTGRES_PASSWORD=
DURIN_APP_PASSWORD=

# ── API (api/) ───────────────────────────────────────────────────────────────
# Runtime connection: the least-privilege login (member of durin_runtime).
DATABASE_URL=postgresql://durin_app:<DURIN_APP_PASSWORD>@localhost:5432/durin
# Migrations: the schema owner. Used only by `pnpm db:migrate`.
MIGRATION_DATABASE_URL=postgresql://durin_owner:<POSTGRES_PASSWORD>@localhost:5432/durin
DURIN_RUNTIME_ROLE=durin_app

PORT=3000
NODE_ENV=development
# 32 random bytes, base64. REQUIRED in production (encrypts webhook signing secrets).
DURIN_ENCRYPTION_KEY=
# Gates POST /v1/organisations. REQUIRED in production (>= 24 chars); open in development if unset.
BOOTSTRAP_TOKEN=
RATE_LIMIT_PER_MINUTE=120
# Behind a reverse proxy set the number of trusted hops (e.g. 1) so client IPs are correct.
TRUST_PROXY=
# Comma-separated browser origins allowed to call the API (none by default: server-to-server API).
CORS_ORIGINS=
# Providers. Production refuses to start with `sandbox`.
LAYER1_ADAPTER=sandbox
LAYER2_ADAPTER=sandbox

# ── Dashboard (dashboard/) — SERVER-SIDE ONLY, never NEXT_PUBLIC_* ───────────
DURIN_API_URL=http://localhost:3000/v1
# Use a READ-ONLY key (organisations:read payments:read conversions:read compliance:read ledger:read).
DURIN_API_KEY=
# Access gate for the whole dashboard. Required in production (it fails closed without it).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ── Integration tests (api: pnpm test:integration) ───────────────────────────
DURIN_TEST_ADMIN_URL=postgresql://postgres:<password>@localhost:5432/durin_test
DURIN_TEST_APP_URL=postgresql://durin_app:<password>@localhost:5432/durin_test
